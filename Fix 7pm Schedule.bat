@echo off
rem Shows the state of the 7pm schedule, rebuilds it with the right settings, and shows it again.
rem Safe to run any time; it doesn't touch your login or download history.
powershell -NoProfile -ExecutionPolicy Bypass -Command "$name = 'Thermpix DPA Sync'; $here = '%~dp0'.TrimEnd([char]92); $py = Join-Path $here '.venv\Scripts\pythonw.exe'; if (-not (Test-Path $py)) { Write-Host 'The program is not installed in this folder - run Install.bat first.' -ForegroundColor Red; exit 1 }; function Show($title) { Write-Host ''; Write-Host $title -ForegroundColor Cyan; $t = Get-ScheduledTask -TaskName $name -ErrorAction SilentlyContinue; if (-not $t) { Write-Host '  No 7pm task found.' -ForegroundColor Yellow; return }; $i = $t | Get-ScheduledTaskInfo; Write-Host ('  State:            ' + $t.State); Write-Host ('  Last run:         ' + $i.LastRunTime); Write-Host ('  Last result code: ' + $i.LastTaskResult + '  (0 = OK, 267009 = still running, 267011 = never run)'); Write-Host ('  Next run:         ' + $i.NextRunTime); Write-Host ('  Runs as:          ' + $t.Principal.UserId + ' (' + $t.Principal.LogonType + ')'); Write-Host ('  Program:          ' + $t.Actions[0].Execute) }; Show 'Before:'; Stop-ScheduledTask -TaskName $name -ErrorAction SilentlyContinue; $action = New-ScheduledTaskAction -Execute $py -Argument ([char]34 + (Join-Path $here 'thermpix_sync.py') + [char]34) -WorkingDirectory $here; $trigger = New-ScheduledTaskTrigger -Daily -At '7:00PM'; $settings = New-ScheduledTaskSettingsSet -StartWhenAvailable -WakeToRun -ExecutionTimeLimit (New-TimeSpan -Hours 4) -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -MultipleInstances IgnoreNew -RestartCount 2 -RestartInterval (New-TimeSpan -Minutes 15); $user = [Security.Principal.WindowsIdentity]::GetCurrent().Name; $principal = New-ScheduledTaskPrincipal -UserId $user -LogonType Interactive -RunLevel Limited; Register-ScheduledTask -TaskName $name -Action $action -Trigger $trigger -Settings $settings -Principal $principal -Description 'Downloads new Thermpix patient images to the DPAs folder' -Force | Out-Null; Remove-Item (Join-Path $env:LOCALAPPDATA 'ThermpixSync\run.lock') -ErrorAction SilentlyContinue; Show 'After:'; Write-Host ''; Write-Host 'The 7pm schedule has been rebuilt.' -ForegroundColor Green"
pause
